APP_ENV=dev

# Cấu hình Port cho từng VOD Source
PORT_JAVTIFUL=5012
PORT_MISSAV=5013
PORT_VLXX=5014
PORT_SEXTOP1=5015
PORT_JAVGURU=5016

# Thư mục gốc chứa toàn bộ các file DB của VODs
TERMUX_DATABASE_ROOT=/sdcard/Database/termux-services
WINDOWS_DATABASE_ROOT=D:/Dat/Database/termux-services

# (Tùy chọn) Chỉ định rõ từng file DB nếu không nằm trong cấu trúc chuẩn
TERMUX_DB_JAVTIFUL=/sdcard/Database/termux-services/javtiful.db
WINDOWS_DB_JAVTIFUL=D:/Dat/Database/termux-services/javtiful.db

TERMUX_DB_MISSAV=/sdcard/Database/termux-services/missav.db
WINDOWS_DB_MISSAV=D:/Dat/Database/termux-services/missav.db

TERMUX_DB_VLXX=/sdcard/Database/termux-services/vlxx.db
WINDOWS_DB_VLXX=D:/Dat/Database/termux-services/vlxx.db

TERMUX_DB_SEXTOP1=/sdcard/Database/termux-services/sextop1.db
WINDOWS_DB_SEXTOP1=D:/Dat/Database/termux-services/sextop1.db

TERMUX_DB_JAVGURU=/sdcard/Database/termux-services/javguru.db
WINDOWS_DB_JAVGURU=D:/Dat/Database/termux-services/javguru.db

# Database tổng nextdjav để map GDrive
TERMUX_NEXTDJAV_DB=/sdcard/Database/termux-services/nextdjav.db
WINDOWS_NEXTDJAV_DB=D:/Dat/Database/termux-services/nextdjav.db
